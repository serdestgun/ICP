rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Her kullanıcı yalnızca kendi belgesini okuyup yazabilir
    match /kullanicilar/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Geri bildirim: herkes yeni kayıt ekleyebilir, kimse okuyamaz/değiştiremez
    // (geri bildirimleri Firebase konsolundan görürsün)
    match /geribildirim/{id} {
      allow create: if request.resource.data.keys().hasOnly(['uid', 'konu', 'puan', 'yorum', 'tarih'])
        && request.resource.data.konu is string && request.resource.data.konu.size() <= 100
        && request.resource.data.puan in [1, -1, 0]
        && request.resource.data.yorum is string && request.resource.data.yorum.size() <= 1000
        && request.resource.data.tarih == request.time
        && (request.resource.data.uid == null
            || (request.auth != null && request.resource.data.uid == request.auth.uid));
      allow read, update, delete: if false;
    }
  }
}
